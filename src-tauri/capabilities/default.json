{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for main and popup windows",
  "windows": ["main", "popup"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:tray:default",
    "store:default",
    "notification:default",
    "dialog:default",
    "opener:default"
  ]
}
