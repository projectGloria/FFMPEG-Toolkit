{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFMPEG-Toolkit",
  "version": "0.1.0",
  "identifier": "com.ffmpegtoolkit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FFMPEG-Toolkit",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 540,
        "visible": false,
        "center": true
      },
      {
        "label": "popup",
        "title": "FFMPEG-Toolkit Progress",
        "url": "index.html?window=popup",
        "width": 440,
        "height": 260,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
